# LLM provider: gemini | groq | ollama (also switchable in the app sidebar)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# replay (tests, no API calls) | record | live
LLM_MODE=replay

GEMINI_API_KEY=
# Groq (OpenAI-compatible endpoint), only needed for LLM_PROVIDER=groq
GROQ_API_KEY=
# Local Ollama server, only used for LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Where identical runs are cached (gitignored). Default: <repo>/.cache
# CACHE_DIR=.cache
